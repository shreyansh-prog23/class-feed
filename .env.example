# ---- who can open the app ----
CLASS_CODE=pick-a-short-code-for-classmates
ADMIN_CODE=a-different-code-only-the-CR-knows

# ---- the AI (start free with Gemini) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_LITE_MODEL=gemini-3-flash-preview
# To use Claude instead: AI_PROVIDER=anthropic and ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
# Hard stop so a bug can never run up a bill (AI calls per day)
DAILY_CALL_CAP=300

# ---- what the listener reads ----
# Only groups whose name contains one of these words are read. Empty = read nothing.
GROUPS=MAIC 209,MAIC 205
# Only these senders are read (part of the saved name or the phone number). Empty = everyone.
SENDERS=
# Group-code to subject name, so cards file under the right subject
SUBJECTS=MAIC 209=Linear Algebra;MAIC 205=Probability

# ---- server ----
PORT=3000
TZ=Asia/Kolkata

# Old-chat import (all optional)
# HISTORY_DAILY_CALLS=120
# HISTORY_RESERVE=80
# HISTORY_MAX_MB=200
# HISTORY_MAX_FILES=400

# PDF reading (optional)
# PDF_AI_PAGES=3

# The whole-class group (words from its name). Every other group in GROUPS is one subject.
# MAIN_GROUPS=AIDS 2026

# Tells the date sheet reader which rows are yours (branch and semester)
CLASS_HINT=AI&DS, 3rd semester
# How many daily backups to keep
BACKUP_KEEP=7

# Sections of the class (labs and some notices are only for one). Default AD-01,AD-02.
# SECTIONS=AD-01,AD-02
# A deadline, exam or class change the AI was unsure about waits this many hours for the CR to check it, then goes live anyway. 0 = never wait.
# HOLD_HOURS=12

# Polls: votes are collected this many minutes, then a clear winner (POLL_MAJORITY percent, at least POLL_MIN_VOTES votes) can become a card.
# POLL_WAIT_MIN=90
# POLL_MIN_VOTES=5
# POLL_MAJORITY=60

# Requests per minute Google allows your key. Free Gemini Flash is 5, Flash Lite 15, paid tiers are far higher.
# The app spaces its calls to stay under this, so a burst never hits the limit. Check AI Studio > Rate Limit.
# AI_RPM=5

# Spreading the day's AI calls. Set DAILY_CALL_CAP to a little under what Google allows your key per day.
# Reading messages may use a share of it that grows through the day (starts at PACE_HEAD, a quarter), and never the last
# ASK_RESERVE share. Ordinary reading never goes past it; Ask, the CR's "fix with AI", polls and urgent messages share the whole cap. Messages wait 7.5 quiet minutes, at most 20 (BATCH_WAIT_MS, BATCH_MAX_MS) so one call reads many.
# DAILY_CALL_CAP=18
# ASK_RESERVE=0.2
# PACE_HEAD=0.25

# Backup models (up to 4, comma separated, in order). Used when the main model is busy (503) or out of calls (429).
# Each model has its own daily allowance. A model that is out of calls for the day is skipped until Google's day changes.
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview,another-model-id
